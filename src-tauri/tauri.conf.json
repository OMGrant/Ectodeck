{
	"$schema": "https://schema.tauri.app/config/2",
	"build": {
		"beforeBuildCommand": "deno task build",
		"beforeDevCommand": "deno task dev",
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173"
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": { "target/plugins/": "plugins/" },
		"linux": {
			"deb": {
				"desktopTemplate": "bundle/ectodeck.desktop",
				"files": {
					"/etc/udev/rules.d/40-streamdeck.rules": "bundle/40-streamdeck.rules",
					"/etc/udev/rules.d/40-magtran-m3.rules": "../plugins/com.grantgarrison.opendeck-magtran-m3.sdPlugin/40-opendeck-magtran-m3.rules",
					"/usr/share/metainfo/ectodeck.metainfo.xml": "bundle/ectodeck.metainfo.xml"
				}
			},
			"rpm": {
				"desktopTemplate": "bundle/ectodeck.desktop",
				"files": {
					"/etc/udev/rules.d/40-streamdeck.rules": "bundle/40-streamdeck.rules",
					"/etc/udev/rules.d/40-magtran-m3.rules": "../plugins/com.grantgarrison.opendeck-magtran-m3.sdPlugin/40-opendeck-magtran-m3.rules",
					"/usr/share/metainfo/ectodeck.metainfo.xml": "bundle/ectodeck.metainfo.xml"
				}
			}
		},
		"publisher": "Grant Garrison",
		"shortDescription": "An enhanced fork of OpenDeck for the VSDinside MagTran M3",
		"longDescription": "Ectodeck is an enhanced fork of OpenDeck for the VSDinside MagTran M3. It keeps OpenDeck's support for Elgato Stream Decks and for plugins made for the Stream Deck SDK.",
		"category": "Productivity",
		"icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
		"macOS": {
			"exceptionDomain": "localhost",
			"signingIdentity": "-"
		}
	},
	"productName": "Ectodeck",
	"mainBinaryName": "ectodeck",
	"identifier": "ectodeck",
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["opendeck", "openaction", "streamdeck"]
			}
		}
	},
	"app": {
		"windows": [
			{
				"title": "Ectodeck",
				"decorations": false,
				"fullscreen": false,
				"resizable": true,
				"width": 800,
				"height": 600,
				"minWidth": 800,
				"minHeight": 600,
				"center": true,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src * data:; frame-src http://localhost:* https:; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://openactionapi.github.io https://api.github.com https://raw.githubusercontent.com https://plugins.amankhanna.me;"
		},
		"withGlobalTauri": true
	}
}
